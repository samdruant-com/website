# Env variables are loaded through the nuxt.config.js file. Variables that start with
# NUXT_PUBLIC_ are loaded into the client-side (DO NOT PUT SENSITIVE INFORMATION HERE
# AS IT WILL BE VISIBLE IN THE BROWSER) and variables that start with NUXT_ are loaded
# into the server-side.
#
# For more information, please refer to the following link:
# https://nuxt.com/docs/guide/going-further/runtime-config#environment-variables

NUXT_PUBLIC_MEDIA_URL=api.example.com/uploads
NUXT_API_URL=api.example.com/api
NUXT_API_TOKEN=*****